# Backend services. Defaults to the local dev ports when unset.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:4001
NEXT_PUBLIC_CORE_API_URL=http://localhost:4002
NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:4003

# Public site URL (used for share links).
NEXT_PUBLIC_APP_URL=http://localhost:5000

# Sentry (free tier). Leave the DSN empty to keep Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
